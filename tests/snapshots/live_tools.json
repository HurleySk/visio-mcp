[
  {
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "title": "Find Visio Masters"
    },
    "description": "Search Visio's installed shapes for masters to use in a diagram.\n\nMatches master names first, then stencil titles and keywords, so \"flowchart decision\"\nfinds BASFLO:Decision. Pass stencil alone to list one stencil's masters. Use the returned\n\"master\" value in visio_create_diagram and visio_add_elements. Does not need Visio running.",
    "inputSchema": {
      "properties": {
        "query": {
          "default": "",
          "type": "string"
        },
        "stencil": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limit": {
          "default": 25,
          "type": "integer"
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "name": "visio_find_masters",
    "title": "Find Visio Masters"
  },
  {
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "title": "List Visio Templates"
    },
    "description": "List Visio's installed templates, optionally filtered by words in their title or keywords.\n\nPass the returned \"template\" value to visio_new_drawing or visio_create_diagram.\nDoes not need Visio running.",
    "inputSchema": {
      "properties": {
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "name": "visio_list_templates",
    "title": "List Visio Templates"
  },
  {
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "title": "List Open Visio Drawings"
    },
    "description": "List the drawings open in Visio, saying which is active. Never starts Visio.\n\nReports running=false if Visio isn't running. Includes saved drawings in other Visio\nwindows where Windows lets them be reached.",
    "inputSchema": {
      "properties": {},
      "type": "object",
      "additionalProperties": false
    },
    "name": "visio_list_open",
    "title": "List Open Visio Drawings"
  },
  {
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "title": "Read Visio Page"
    },
    "description": "List a page's top-level shapes and connectors, one page of results at a time.\n\nShapes have centre x, y and size w, h in inches, from the bottom-left of the page.\nConnectors say which shape IDs they join in \"from\" and \"to\", where null means not glued.\nPass next_offset back as offset to continue. Use visio_get_shape for a shape's data.",
    "inputSchema": {
      "properties": {
        "offset": {
          "default": 0,
          "type": "integer"
        },
        "limit": {
          "default": 100,
          "type": "integer"
        },
        "drawing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "name": "visio_get_page",
    "title": "Read Visio Page"
  },
  {
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "title": "Read Visio Shape"
    },
    "description": "Read one shape in detail: position, Shape Data, connections, container and group members.\n\nshape is an ID, else an exact name, else exact text. cells adds ShapeSheet cells by name,\nsuch as \"FillForegnd\", with null for a cell the shape doesn't have.",
    "inputSchema": {
      "properties": {
        "shape": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "cells": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "drawing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "shape"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "name": "visio_get_shape",
    "title": "Read Visio Shape"
  },
  {
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "title": "Find Visio Shapes"
    },
    "description": "Find a page's top-level shapes by text (part of it, ignoring case), master name, or Shape Data.\n\nFilters combine. data matches a field's label or row name against an exact value,\nignoring case. Returns at most 200 shapes with the total found.",
    "inputSchema": {
      "properties": {
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "master": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "drawing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "name": "visio_find_shapes",
    "title": "Find Visio Shapes"
  },
  {
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "title": "Read Visio Selection"
    },
    "description": "Read what's selected in the active Visio window, so you can act on what the user points at.",
    "inputSchema": {
      "properties": {},
      "type": "object",
      "additionalProperties": false
    },
    "name": "visio_get_selection",
    "title": "Read Visio Selection"
  },
  {
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "title": "Get Visio Page Image"
    },
    "description": "Get a PNG of a page, to check how a diagram looks. Doesn't change focus or the drawing.\n\nThe image is cropped to the shapes, and its longest side is at most max_px, unless a very\nlarge page needs more to stay legible. annotate_ids badges each shape with its ID.",
    "inputSchema": {
      "properties": {
        "max_px": {
          "default": 1400,
          "type": "integer"
        },
        "annotate_ids": {
          "default": false,
          "type": "boolean"
        },
        "drawing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "name": "visio_get_page_image",
    "title": "Get Visio Page Image"
  },
  {
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false,
      "title": "New Visio Drawing"
    },
    "description": "Create a new drawing, starting a visible Visio if none is running.\n\ntemplate is a name from visio_list_templates or the absolute path of a template file.\nOmit it for a blank drawing. units picks US or metric paper and shapes.",
    "inputSchema": {
      "properties": {
        "template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "units": {
          "anyOf": [
            {
              "enum": [
                "us",
                "metric"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "name": "visio_new_drawing",
    "title": "New Visio Drawing"
  },
  {
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false,
      "title": "Open Visio Drawing"
    },
    "description": "Open a saved drawing, starting a visible Visio if none is running.\n\nIf it's already open, returns that one with already_open=true, even if it was opened\nwith different access. Check read_only in the result.",
    "inputSchema": {
      "properties": {
        "path": {
          "type": "string"
        },
        "read_only": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "name": "visio_open_drawing",
    "title": "Open Visio Drawing"
  },
  {
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "annotations": {
      "destructiveHint": true,
      "readOnlyHint": false,
      "title": "Save Visio Drawing"
    },
    "description": "Save a drawing, or save a copy to a new absolute path and continue in that copy.\n\nRefuses to replace another file unless overwrite is true. A read-only drawing can only\nbe saved to a new path, and the result is writable.",
    "inputSchema": {
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "overwrite": {
          "default": false,
          "type": "boolean"
        },
        "drawing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "name": "visio_save",
    "title": "Save Visio Drawing"
  },
  {
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "annotations": {
      "destructiveHint": true,
      "readOnlyHint": false,
      "title": "Export Visio Drawing"
    },
    "description": "Export to an absolute path as PNG, JPG, SVG or PDF. The format comes from the extension.\n\nImages export one page: the named one, else the one on screen. PDF exports the named\npage, else every page. Refuses to replace a file unless overwrite is true.",
    "inputSchema": {
      "properties": {
        "path": {
          "type": "string"
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "png",
                "jpg",
                "svg",
                "pdf"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "overwrite": {
          "default": false,
          "type": "boolean"
        },
        "drawing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "path"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "name": "visio_export",
    "title": "Export Visio Drawing"
  },
  {
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "annotations": {
      "destructiveHint": true,
      "readOnlyHint": false,
      "title": "Close Visio Drawing"
    },
    "description": "Close a drawing. Visio itself stays open.\n\nRefuses if there are unsaved changes unless discard is true, which loses them and\nmust name the drawing, so it can't take whichever drawing happens to be active.",
    "inputSchema": {
      "properties": {
        "discard": {
          "default": false,
          "type": "boolean"
        },
        "drawing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "name": "visio_close_drawing",
    "title": "Close Visio Drawing"
  }
]
